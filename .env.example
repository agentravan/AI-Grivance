# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local for local dev. On Vercel, add these under
# Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# 1) LLM — OpenRouter (preferred if set). Key: https://openrouter.ai/settings/keys
#    "openrouter/free" routes each request to an available free model.
#    Free models may log prompts — see README "Privacy" before using for grievances.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# 1b) LLM alternative — Groq free tier (https://console.groq.com/keys). No card required.
#    Groq states it does not train on API inputs. Leave empty to run in
#    "retrieval-only" mode (answers quoted straight from your uploaded docs).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 2) Knowledge store — Upstash Redis free tier.
#    Easiest: Vercel dashboard → Storage → Marketplace → Upstash for Redis →
#    connect to this project. It injects these two variables automatically.
#    Without them the app uses in-memory storage (fine for `npm run dev`, but
#    uploads vanish on Vercel because serverless instances don't share memory).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 3) Admin access for the Training Panel + GO LIVE.
#    ADMIN_PASSCODE: share only with the HR/L&D content owners.
#    AUTH_SECRET: any random string of 32+ chars.
#    Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSCODE=
AUTH_SECRET=

# 4) Grievance mode LLM policy:
#    "redacted" (default) → policy questions go to the LLM after PII redaction.
#    "off"               → grievance mode never calls the LLM; it answers only by
#                           quoting your published policy excerpts.
GRIEVANCE_LLM=redacted

# 5) Pilot banner. Keep "on" until Legal/IT sign off, then set to "off".
PILOT_MODE=on

# 6) Live web search (L&D only) + daily Regulatory & Skills Pulse.
#    Tavily free tier: https://app.tavily.com  (1 credit per basic search)
#    Without this key, web search switches off quietly ("live web: off").
TAVILY_API_KEY=
ENABLE_WEB_SEARCH=true
WEB_MONTHLY_CAP=900
# Optional: restrict L&D search to trusted sites (comma-separated)
WEB_INCLUDE_DOMAINS=
# Optional: extra certification/course names that can trigger search
WEB_ENTITIES=
# Protects the daily cron endpoint (Vercel sends it automatically). Any random string.
CRON_SECRET=
# Optional: add state-specific rules to the Pulse, e.g. Haryana
PULSE_STATE=
# Optional: fully custom Pulse topics as JSON: [{"q":"...","scope":"hr"|"ld"|"both","domains":["..."]}]
PULSE_TOPICS=
